<brls:Box
    width="auto"
    height="auto">

    <brls:ScrollingFrame
        id="scroll"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0" >
        
        <brls:Box
            width="10000"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/tab_details/padding_top"
            paddingRight="@style/brls/tab_details/padding_right"
            paddingBottom="@style/brls/tab_details/padding_bottom"
            paddingLeft="@style/brls/tab_details/padding_left">
            
            <BoldLabel
                id="page_title"
                width="auto"
                height="auto"
                marginBottom="24"
                fontSize="30"/>

            <brls:Box
                id="menu"
                width="auto"
                height="auto"
                axis="column"
                alignItems="stretch"/>

            <brls:Box
                id="group_video"
                width="auto"
                height="auto"
                axis="column"
                alignItems="stretch"
                visibility="gone">

                <brls:Header
                    title="@i18n/settings/quality"/>

                <brls:SelectorCell
                    id="fps"/>

                <brls:SelectorCell
                    id="frame_pacing"/>

                <brls:SelectorCell
                    id="resolution"/>

                <brls:SelectorCell
                    id="resolution_scale"/>

                <brls:SelectorCell
                    id="codec"/>

                <brls:BooleanCell
                    id="request_hdr"/>

                <brls:SelectorCell
                    id="decoder"/>

                <brls:BooleanCell
                    id="use_hw_decoding"/>

                <brls:Header
                    id="header"
                    title="@i18n/settings/video_bitrate"
                    subtitle="10.0 Mbps"
                    paddingTop="60"/>

                <brls:Slider
                    id="slider"
                    width="auto"
                    height="84"
                    grow="1"/>

            </brls:Box>

            <brls:Box
                id="group_handheld"
                width="auto"
                height="auto"
                axis="column"
                alignItems="stretch"
                visibility="gone">

                <brls:Header
                    id="handheld_header"
                    title="@i18n/settings/handheld_profile"/>

                <brls:BooleanCell
                    id="mode_profiles"/>

                <brls:SelectorCell
                    id="handheld_resolution"/>

                <brls:Header
                    id="handheld_bitrate_header"
                    title="@i18n/settings/handheld_bitrate"
                    subtitle="10.0 Mbps"
                    paddingTop="40"/>

                <brls:Slider
                    id="handheld_bitrate_slider"
                    width="auto"
                    height="84"
                    grow="1"/>

            </brls:Box>

            <brls:Box
                id="group_image"
                width="auto"
                height="auto"
                axis="column"
                alignItems="stretch"
                visibility="gone">

                <brls:Header
                    id="image_adjustments_header"
                    title="@i18n/settings/image_adjustments"/>

                <BooleanSliderCell
                    id="dithering"/>

                <brls:BooleanCell
                    id="upscaling"/>

                <brls:SelectorCell
                    id="upscaling_mode"/>

                <BooleanSliderCell
                    id="rcas"/>

            </brls:Box>

            <brls:Box
                id="group_audio"
                width="auto"
                height="auto"
                axis="column"
                alignItems="stretch"
                visibility="gone">

                <brls:Header
                    title="@i18n/settings/stream_settings"/>

                <brls:SelectorCell
                    id="audio_backend"/>

                <brls:BooleanCell
                    id="optimal"/>

                <brls:BooleanCell
                    id="pcAudio"/>

                <brls:BooleanCell
                    id="volume_amplification"/>

            </brls:Box>

            <brls:Box
                id="group_controls"
                width="auto"
                height="auto"
                axis="column"
                alignItems="stretch"
                visibility="gone">

                <brls:Header
                    title="@i18n/settings/keys"/>

                <brls:BooleanCell
                    id="swap_ui"/>

                <brls:DetailCell
                    id="swap_game"/>


                <brls:Header
                    title="@i18n/settings/deadzone/title"
                    paddingTop="60"/>

                <brls:DetailCell
                    id="dead_zone_stick_left"/>

                <brls:DetailCell
                    id="dead_zone_stick_right"/>

                <brls:Header
                    id="rumble_slider_header"
                    title="@i18n/settings/rumble_force"
                    subtitle="100%"
                    paddingTop="60"/>

                <brls:Slider
                    id="rumble_slider"
                    width="auto"
                    height="84"
                    grow="1"/>

                <brls:Header
                    title="@i18n/settings/single_joycon"
                    paddingTop="60"/>

                <brls:BooleanCell
                    id="swap_stick_to_dpad"/>

            </brls:Box>

            <brls:Box
                id="group_shortcuts"
                width="auto"
                height="auto"
                axis="column"
                alignItems="stretch"
                visibility="gone">

                <brls:Header
                    title="@i18n/settings/guide_key"/>

                <brls:DetailCell
                    id="guide_key_buttons"/>

                <brls:SelectorCell
                    id="guide_by_system_button"/>

                <brls:Header
                    title="@i18n/settings/overlay"
                    paddingTop="60"/>

                <brls:SelectorCell
                    id="overlay_time"/>

                <brls:DetailCell
                    id="overlay_buttons"/>

                <brls:SelectorCell
                    id="overlay_by_system_button"/>

                <brls:Header
                    title="@i18n/settings/mouse_input"
                    paddingTop="60"/>

                <brls:SelectorCell
                    id="mouse_input_time"/>

                <brls:DetailCell
                    id="mouse_input_buttons"/>

            </brls:Box>

            <brls:Box
                id="group_input"
                width="auto"
                height="auto"
                axis="column"
                alignItems="stretch"
                visibility="gone">

                <brls:Header
                    title="@i18n/settings/keyboard"/>

                <brls:SelectorCell
                    id="keyboard_type"/>

                <brls:SelectorCell
                    id="keyboard_fingers"/>

                <brls:Header
                    title="@i18n/settings/mouse"
                    paddingTop="60"/>

                <brls:BooleanCell
                    id="touchscreen_mouse_mode"/>

                <brls:BooleanCell
                    id="swap_mouse_keys"/>

                <brls:BooleanCell
                    id="swap_mouse_scroll"/>

                <brls:Header
                    id="mouse_speed_header"
                    title="@i18n/settings/mouse_speed"
                    subtitle="x1.0"
                    paddingTop="60"/>

                <brls:Slider
                    id="mouse_speed_slider"
                    width="auto"
                    height="84"
                    grow="1"/>

            </brls:Box>

            <brls:Box
                id="group_system"
                width="auto"
                height="auto"
                axis="column"
                alignItems="stretch"
                visibility="gone">

                <brls:Header
                    title="@i18n/settings/debug"/>

                <brls:BooleanCell
                    id="writeLog"/>

                <brls:Header
                    title="@i18n/update/title"
                    paddingTop="60"/>

                <brls:DetailCell
                    id="check_update"/>

            </brls:Box>

        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>
